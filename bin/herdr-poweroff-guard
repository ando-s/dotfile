#!/usr/bin/env python3
"""定時停止で Herdr の session.json が削られるのを防ぐ。

save:    停止直前に cron から呼び、session.json を退避する
restore: 起動時に cron の @reboot から呼び、停止の間際に削られていたら退避分で戻す

電源断のときは、ペインが1つずつ終わるたびに session.json が保存し直され、
ワークスペースが減っていく。退避した直後に停止が来て、しかも数が減っていた
ときだけ戻す。退避のあと人が使い続けた日には戻さない。
"""
import json
import os
import shutil
import subprocess
import sys
import time

HERDR_DIR = os.environ.get("HERDR_GUARD_DIR", os.path.expanduser("~/.config/herdr"))
SESSION = os.path.join(HERDR_DIR, "session.json")
BACKUP = os.path.join(HERDR_DIR, "session.json.pre-poweroff")
# 退避から最後の保存までがこの秒数以内なら、停止の間際に削られたとみなす
WINDOW_SECONDS = 10 * 60


def log(msg):
    print(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {msg}", flush=True)


def workspace_count(path):
    with open(path) as f:
        return len(json.load(f).get("workspaces", []))


def server_running():
    return subprocess.run(
        ["pgrep", "-u", str(os.getuid()), "-f", r"herdr server$"],
        stdout=subprocess.DEVNULL,
    ).returncode == 0


def save():
    if not os.path.exists(SESSION):
        log("session.json が無いため退避しない")
        return
    shutil.copy2(SESSION, BACKUP)
    log(f"退避した workspaces={workspace_count(BACKUP)}")


def restore():
    if not os.path.exists(BACKUP):
        log("退避が無いため戻さない")
        return
    if not os.path.exists(SESSION):
        log("session.json が無いため戻さない。persist.clear の可能性があるので herdr-restore で確かめる")
        return
    if server_running():
        log("herdr server が動いているため戻さない。herdr-restore で開き直す")
        return

    gap = os.path.getmtime(SESSION) - os.path.getmtime(BACKUP)
    before = workspace_count(BACKUP)
    after = workspace_count(SESSION)
    used = BACKUP + ".used"

    if gap > WINDOW_SECONDS:
        log(f"退避のあとも使われていたため戻さない gap={int(gap)}s")
    elif after >= before:
        log(f"削られていないため戻さない before={before} after={after}")
    else:
        shutil.copy2(SESSION, SESSION + ".shrunk")
        shutil.copy2(BACKUP, SESSION)
        log(f"戻した before={before} after={after}。削られた方は session.json.shrunk")
    os.replace(BACKUP, used)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "save":
        save()
    elif cmd == "restore":
        restore()
    else:
        print("usage: herdr-poweroff-guard save|restore", file=sys.stderr)
        sys.exit(2)
