#!/usr/bin/env python3
"""セッションに「メイン」の印を付け、使わないセッションを棚に上げる。

  優先度: 高・中・低。herdr-pick で優先度の順に並べる。自分で付けていないものは「なし」。高にはサイドバーに ★ を出す
  棚:     ペイン（ワークスペースにほかのペインが無ければワークスペースごと）を閉じ、
          会話は残す。herdr-pick の「棚」から claude --resume で同じ名前のまま開き直す。
          herdr-restore は棚のセッションを開き直さない

印と棚は ~/.claude/herdr-sessions/main/ と shelf/ に、セッションIDごとのファイルで持つ。

  herdr-focus main [<workspace_id>]       ワークスペースのセッションのメインを切り替える
  herdr-focus shelve [<workspace_id>]     ワークスペースのセッションを棚に上げる
  herdr-focus priority-session <session_id> [高|中|低]
                                          優先度を変える。省くと なし→高→中→低→なし の順に回す
  herdr-focus shelve-session <session_id> 1つのセッションを棚に上げる
  herdr-focus save-and-shelve <session_id>
                                          セッションに、ここまでの結論と残りの作業を書かせてから棚に上げる。
                                          裏で動き、書き終わるのを待つ。許可や入力を求めて止まったら棚に上げない
  herdr-focus unshelve <session_id>       棚から開き直す
  herdr-focus sync                        メインの ★ をサイドバーに出し直す（herdr の再起動後など）
既定のワークスペースは今のもの。
"""
import glob
import json
import os
import shlex
import subprocess
import sys
import time

BASE = os.path.expanduser("~/.claude/herdr-sessions")
MAIN_DIR = os.path.join(BASE, "main")  # 前の「メイン」の印。読むときは優先度「高」とみなす
PRIORITY_DIR = os.path.join(BASE, "priority")
PRIORITIES = ["高", "中", "低"]
NO_PRIORITY = "なし"  # 自分で付けていない。ファイルを置かない
CYCLE = [NO_PRIORITY, *PRIORITIES]
SHELF_DIR = os.path.join(BASE, "shelf")
LABEL_DIR = os.path.join(BASE, "labels")
PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
SOURCE = "herdr-focus"
PENDING_DIR = os.path.join(BASE, "shelf-pending")
SAVE_PROMPT = (
    "このセッションをいったん閉じる。あとで新しいセッションから続きを始められるよう、"
    "ここまでの結論・決まったこと・残りの作業を、この作業の記録先に書いて。"
    "記録先は、実装でなければ claude_tasks のタスクファイル、実装なら計画ファイルかチケット。"
    "書き終えたら、書いた場所のパスかチケットのキーだけを最後に1行で出して。"
)
SAVE_TIMEOUT_MS = 15 * 60 * 1000
MAIN_MARK = "★"


def herdr(*args):
    result = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=10)
    try:
        return json.loads(result.stdout).get("result") or {}
    except json.JSONDecodeError:
        return {}


def panes():
    return herdr("pane", "list").get("panes", [])


def session_of(pane):
    return (pane.get("agent_session") or {}).get("value")


def priority_of(session_id):
    try:
        with open(os.path.join(PRIORITY_DIR, session_id)) as f:
            value = f.read().strip()
            if value in PRIORITIES:
                return value
    except OSError:
        pass
    return "高" if os.path.exists(os.path.join(MAIN_DIR, session_id)) else NO_PRIORITY


def set_priority(session_id, value=None):
    """value を省くと なし→高→中→低→なし の順に回す。なしにするとファイルを消す。"""
    if value not in CYCLE:
        value = CYCLE[(CYCLE.index(priority_of(session_id)) + 1) % len(CYCLE)]
    path = os.path.join(PRIORITY_DIR, session_id)
    if value == NO_PRIORITY:
        if os.path.exists(path):
            os.remove(path)
    else:
        os.makedirs(PRIORITY_DIR, exist_ok=True)
        with open(path, "w") as f:
            f.write(value)
    old_main = os.path.join(MAIN_DIR, session_id)
    if os.path.exists(old_main):
        os.remove(old_main)
    sync()
    print(f"優先度を「{value}」にしました")


def is_main(session_id):
    return priority_of(session_id) == "高"


def current_workspace(arg):
    # HERDR_WORKSPACE_ID はペインを別のワークスペースへ移しても変わらないため、herdr に今のペインを聞く
    workspace_id = (arg or os.environ.get("HERDR_ACTIVE_WORKSPACE_ID")
                    or herdr("pane", "current").get("pane", {}).get("workspace_id"))
    if not workspace_id:
        sys.exit("ワークスペースIDを指定してください")
    return workspace_id


def sync():
    """メインのセッションのペインとワークスペースに ★ を出し、メインでないものからは消す。"""
    all_panes = panes()
    main_workspaces = set()
    for pane in all_panes:
        session_id = session_of(pane)
        if session_id and is_main(session_id):
            main_workspaces.add(pane["workspace_id"])
            herdr("pane", "report-metadata", pane["pane_id"], "--source", SOURCE, "--token", f"focus={MAIN_MARK}")
        else:
            herdr("pane", "report-metadata", pane["pane_id"], "--source", SOURCE, "--clear-token", "focus")
    for workspace_id in {p["workspace_id"] for p in all_panes}:
        if workspace_id in main_workspaces:
            herdr("workspace", "report-metadata", workspace_id, "--source", SOURCE, "--token", f"focus={MAIN_MARK}")
        else:
            herdr("workspace", "report-metadata", workspace_id, "--source", SOURCE, "--clear-token", "focus")


def toggle_main(session_ids):
    os.makedirs(MAIN_DIR, exist_ok=True)
    turn_on = not all(is_main(s) for s in session_ids)
    for session_id in session_ids:
        path = os.path.join(MAIN_DIR, session_id)
        if turn_on:
            open(path, "w").close()
        elif os.path.exists(path):
            os.remove(path)
    sync()
    print(("メインにしました" if turn_on else "メインから外しました") + f": {len(session_ids)} 件")


def transcript_cwd(session_id):
    """会話の記録に最後に書かれた作業ディレクトリ。worktree に入ったセッションは worktree を返す。"""
    paths = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{session_id}.jsonl"))
    if not paths:
        return None
    cwd = None
    with open(paths[0]) as f:
        for line in f:
            if '"cwd"' not in line:
                continue
            try:
                cwd = json.loads(line).get("cwd") or cwd
            except json.JSONDecodeError:
                continue
    return cwd


def session_label(session_id, workspace):
    try:
        with open(os.path.join(LABEL_DIR, f"{session_id}.txt")) as f:
            state = json.load(f)
    except (OSError, json.JSONDecodeError):
        state = {}
    ref = (state.get("ticket") or {}).get("key") or (f"!{state['mr']['iid']}" if (state.get("mr") or {}).get("iid") else "")
    return state.get("label") or workspace.get("label", ""), ref


def shelve(session_ids, force=False):
    all_panes = panes()
    targets = [p for p in all_panes if session_of(p) in session_ids]
    working = [p["pane_id"] for p in targets if p.get("agent_status") == "working"]
    if working and not force:
        sys.exit(f"作業中のため棚に上げません: {', '.join(working)}")
    os.makedirs(SHELF_DIR, exist_ok=True)
    for pane in targets:
        session_id = session_of(pane)
        workspace = herdr("workspace", "get", pane["workspace_id"]).get("workspace", {})
        label, ref = session_label(session_id, workspace)
        entry = {
            "session_id": session_id,
            "label": label,
            "ref": ref,
            "cwd": transcript_cwd(session_id) or pane.get("foreground_cwd") or pane.get("cwd"),
            "shelved_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        }
        with open(os.path.join(SHELF_DIR, f"{session_id}.json"), "w") as f:
            json.dump(entry, f, ensure_ascii=False)

    for workspace_id in {p["workspace_id"] for p in targets}:
        in_workspace = [p for p in all_panes if p["workspace_id"] == workspace_id]
        if all(p in targets for p in in_workspace):
            herdr("workspace", "close", workspace_id)
        else:
            for pane in targets:
                if pane["workspace_id"] == workspace_id:
                    herdr("pane", "close", pane["pane_id"])
    print(f"棚に上げました: {len(targets)} 件")


def unshelve(session_id):
    path = os.path.join(SHELF_DIR, f"{session_id}.json")
    with open(path) as f:
        entry = json.load(f)
    cwd = entry.get("cwd")
    if not cwd or not os.path.isdir(cwd):
        sys.exit(f"作業ディレクトリがありません: {cwd}")
    created = herdr("workspace", "create", "--cwd", cwd, "--label", entry.get("label") or session_id[:8], "--focus")
    pane_id = created["root_pane"]["pane_id"]
    herdr("pane", "run", pane_id, f"cd {shlex.quote(cwd)} && claude --resume {session_id}")
    os.remove(path)
    print(f"棚から開き直しました: {entry.get('label')}")


def save_and_shelve(session_id):
    """書かせる依頼を送り、終わるのを裏で待ってから棚に上げる。"""
    pane = next((p for p in panes() if session_of(p) == session_id), None)
    if not pane:
        sys.exit("セッションが開いていません")
    if pane.get("agent_status") in ("working", "blocked"):
        sys.exit("作業中か要対応のため、使ってないにしません")
    os.makedirs(PENDING_DIR, exist_ok=True)
    open(os.path.join(PENDING_DIR, session_id), "w").close()
    subprocess.Popen([os.path.abspath(__file__), "--save-worker", session_id, pane["pane_id"]],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def save_worker(session_id, pane_id):
    pending = os.path.join(PENDING_DIR, session_id)
    try:
        result = subprocess.run(
            ["herdr", "agent", "prompt", pane_id, SAVE_PROMPT, "--wait", "--until", "idle", "--until", "done",
             "--until", "blocked", "--timeout", str(SAVE_TIMEOUT_MS)],
            capture_output=True, text=True, timeout=SAVE_TIMEOUT_MS / 1000 + 30,
        )
        status = (herdr("pane", "get", pane_id).get("pane") or {}).get("agent_status")
        # 許可や入力を求めて止まったとき・失敗したときは閉じない。利用者が画面で見て決める
        if result.returncode == 0 and status in ("idle", "done"):
            shelve([session_id])
    finally:
        if os.path.exists(pending):
            os.remove(pending)


def sessions_in(workspace_id):
    ids = [session_of(p) for p in panes() if p["workspace_id"] == workspace_id]
    ids = [s for s in ids if s]
    if not ids:
        sys.exit("このワークスペースに Claude のセッションがありません")
    return ids


def main():
    args = sys.argv[1:]
    force = "--force" in args
    args = [a for a in args if a != "--force"]
    command, rest = (args[0], args[1:]) if args else ("", [])
    arg = rest[0] if rest else None
    if command == "main":
        toggle_main(sessions_in(current_workspace(arg)))
    elif command == "shelve":
        shelve(sessions_in(current_workspace(arg)), force)
    elif command == "main-session" and arg:
        toggle_main([arg])
    elif command == "priority-session" and arg:
        set_priority(arg, rest[1] if len(rest) > 1 else None)
    elif command == "shelve-session" and arg:
        shelve([arg], force)
    elif command == "save-and-shelve" and arg:
        save_and_shelve(arg)
    elif command == "--save-worker" and len(rest) == 2:
        save_worker(*rest)
    elif command == "unshelve" and arg:
        unshelve(arg)
    elif command == "sync":
        sync()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
